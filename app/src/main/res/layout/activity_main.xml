<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="21sp"
                    android:fontFamily="serif"
                    android:textColor="@color/text" />
                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
            </LinearLayout>
            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="00:00"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Entrar ─────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/panelJoin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_title"
                android:textSize="20sp"
                android:fontFamily="serif" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/join_sub"
                android:textColor="@color/muted" />
            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="@string/code_hint"
                android:inputType="number"
                android:maxLength="11"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:importantForAutofill="no" />
            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="@string/name_hint"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="14dp"
                android:importantForAutofill="no" />
            <CheckBox
                android:id="@+id/consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/brand"
                android:text="@string/consent"
                android:textColor="@color/text"
                android:textSize="13.5sp" />
            <TextView
                android:id="@+id/joinError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnJoin"
                style="@style/SpButton"
                android:layout_marginTop="14dp"
                android:text="@string/join" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/privacy"
                android:textColor="@color/muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ── Sesión ─────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/panelSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/lastBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tip"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/lastWho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/lastBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="15.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <Button
                    android:id="@+id/btnShare"
                    style="@style/SpButton"
                    android:text="@string/share" />
                <Button
                    android:id="@+id/btnMic"
                    style="@style/SpButton.Sec"
                    android:layout_marginTop="10dp"
                    android:text="@string/mic_on" />
                <Button
                    android:id="@+id/btnOverlay"
                    style="@style/SpButton.Sec"
                    android:layout_marginTop="10dp"
                    android:text="@string/overlay"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/shareTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat con tu técnico"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/chatLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="80dp"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/msg"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/msg_hint"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="12dp"
                        android:importantForAutofill="no" />
                    <Button
                        android:id="@+id/btnSend"
                        style="@style/SpButton.Sec"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="14dp"
                        android:text="@string/send" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnEnd"
                style="@style/SpButton.Danger"
                android:layout_marginTop="14dp"
                android:text="@string/end" />
        </LinearLayout>

        <!-- ── Fin ────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/panelEnded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ended_title"
                android:textSize="20sp"
                android:fontFamily="serif" />
            <TextView
                android:id="@+id/endedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="¿Cómo te atendimos?"
                android:textColor="@color/muted" />
            <RatingBar
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:numStars="5"
                android:stepSize="1"
                android:progressTint="#D69A2D" />
            <Button
                android:id="@+id/btnRate"
                style="@style/SpButton"
                android:layout_marginTop="10dp"
                android:text="@string/rate" />
            <Button
                android:id="@+id/btnNew"
                style="@style/SpButton.Sec"
                android:layout_marginTop="10dp"
                android:text="@string/new_session" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
